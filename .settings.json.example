{
  "github": {
    "orgs": {
      "example-org": {"auth": "none", "scan": true},
      "example-org-hris": {"auth": "none", "scan": true},
      "example-org-test": {"auth": "none", "scan": false},
      "another-org": {"auth": "none", "scan": true},
      "example-website": {"auth": "none", "scan": true}
    }
  },
  "_github_note": "Every GitHub org LDE reads, keyed by org name. auth is one of: \"app\" (the org's own GitHub App: \"app_id\" plus \"private_key_path\" to a chmod 600 PEM; Settings -> Create app for <org> fills these in), \"enterprise\" (the enterprise_app below), \"pat\" (DEPRECATED: \"token\", a fine-grained PAT for that org) or \"none\". scan: true puts the org in runs that name no orgs. There is no \"*\" org. Optional top-level \"enterprise_app\": {\"enterprise\": \"<slug>\", \"app_id\": \"<id>\", \"private_key_path\": \"<pem>\"}. Change orgs in Settings or PUT /api/github/orgs/<org>; app keys are never set through the API. In AWS the lde/github secret holds this map with inline private_key values. See docs/github-app.md.",
  "gemini_model": "gemini-3.8-flash",
  "_gemini_model_note": "Gemini model used for package extraction. Override without redeploying via LDE_GEMINI_MODEL env var or PUT /api/settings.",
  "dtrack_url": "http://localhost:8081",
  "dtrack_api_key": "",
  "ort_image": "ghcr.io/oss-review-toolkit/ort:latest",
  "_ort_image_note": "For TLS-intercepting environments, build the local image with `docker compose --profile build build ort-image` and set ort_image to 'library-dependency-explorer/ort:local'.",
  "ort_egress_network": "ort-egress",
  "npm_cache_url": "http://npm-cache:9999",
  "npm_cache_probe_url": "http://127.0.0.1:9999",
  "pypi_cache_url": "http://pypi-cache:9998/simple/",
  "pypi_cache_probe_url": "http://127.0.0.1:9998",
  "athens_url": "http://athens:3000",
  "athens_probe_url": "http://127.0.0.1:3000",
  "enabled_package_managers": [
    "NPM", "Yarn", "PIP", "Pipenv", "Poetry", "GoMod", "Maven", "Gradle"
  ],
  "_enabled_package_managers_note": "Remove 'GoMod' to skip Go analyses (often 15-25 min/repo cold). Same for Maven/Gradle if slow.",
  "ort_max_workers": 4,
  "run_retention": 3
}
